# Device dumps contain Mackie's copyrighted firmware and per-unit identifiers - never commit
dumps/

# Generated artifacts (rebuild with install/)
build/

# Local experiments (e.g. the installer spike)
.tmp/

# Third-party binaries (download with install/release/vendor.sh, see docs/DEVELOPMENT.md)
vendor/

*.img
*.upd
# eMMC backups and dumps outside dumps/ (they hold the lock PIN and Mackie's firmware): the
# installer's backup, the dumper card's chunks, loose firmware files (*.bin: the repo needs none) and
# a copied mixer server folder
*.zst
dlzmod-backup/
*.bin
srv/
__pycache__/
# built packages and their signatures (build/ holds them; a copy elsewhere is not to be published)
*.tar
*.tar.sig

# Keys and local config never belong here: private signing keys live outside the repo (mkkeys.sh),
# sd.env in WSL (sd.env.example); a second net in case one is copied in by mistake (SSH keys have
# no extension: id_* and the dev card's dlz-dev*)
*.pem
*.key
id_*
dlz-dev*
sd.env
.env
dev/push.env
