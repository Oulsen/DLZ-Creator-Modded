[Unit]
Description=dlzmod: the last starts' syslog, for server.js to copy to DLZDATA
# Not part of the start: dlzmod-bootreport starts it once its report is in the log (#136), so it
# never runs while a start can still hang. No [Install]: apply-mod.sh removes the old
# multi-user.target.wants link. The file stays in every package: v0.2.0's updater requires it

[Service]
Type=oneshot
TimeoutStartSec=60
Nice=19
IOSchedulingClass=idle
ExecStart=/usr/local/sbin/dlzmod-bootlog
