#!/bin/sh
# Keeps the clock going forward over a power-off (#1). The mixer has no clock battery and the power
# switch never gives a clean shutdown, the only time stock's fake-hwclock saves the time, so every
# cold start went back to the saved time of the factory (notes/system.md, "Clock").
#   floor <dir>  at start, from dlzmod-update while it has DLZDATA mounted read-only (before the
#          mixer software, without a unit of its own that would wait for basic.target): a file
#          newer than the clock (written after the last save, before the power went) moves the
#          clock just past it, so new files sort after the old ones; the kernel's time zone first
#   run    saves the time now and then every minute (dlzmod-clock.service); a TERM (the unit's
#          stop) saves once more and ends it, in this one process, so no two saves race; follows a
#          change to or from summer time with the kernel's time zone
#   zone   gives the kernel the time zone's offset now (#9)
#   save   saves the time once
#   newest <dir> <now>  the time floor would set, or nothing (for the tests)
# The saved file keeps fake-hwclock's format: its load at the next start (sysinit, forward only)
# reads it. Written next to it and renamed over it, so a power cut leaves the old or the new time,
# never an empty file. (fake-hwclock's own save at a clean shutdown still writes it in place, after
# this unit's last save: an update may not add a drop-in for its unit.)
set -u

FILE=${DLZMOD_CLOCK_FILE:-/etc/fake-hwclock.data}
INTERVAL=${DLZMOD_CLOCK_INTERVAL:-60}
# Only files at most this far ahead of the clock count: the time lost at a power-off is at most one
# interval, and the clock at the floor is the saved time plus the seconds since power-on. A file
# further ahead was written elsewhere (a computer in another time zone, or one whose clock runs
# fast) and must not throw the clock into the future, where the forward-only clock would stay.
AHEAD=120
# the floor's whole search; a card that slow gives no answer, not a partial one
FIND_LIMIT=10
# the offset the kernel was last given (zone), +HHMM
ZONE=""

log() { echo "dlzmod-clock: $*"; }

save() {
  local tmp=$FILE.dlzmod-new.$$
  date -u '+%Y-%m-%d %H:%M:%S' > "$tmp" && sync "$tmp" && mv -f "$tmp" "$FILE" \
    && sync "$(dirname "$FILE")" || { rm -f "$tmp"; log "cannot save the time to $FILE"; return 1; }
}

# newest <dir> <now>: just past the newest file in <dir> that is ahead of <now> by at most AHEAD
# seconds, nothing when there is none or the search took over FIND_LIMIT seconds. FAT keeps times
# in steps of 2 s, rounded down: + 2 is past the real time.
newest() {
  local times
  times=$(timeout "$FIND_LIMIT" find "$1" -xdev -type f -printf '%T@\n' 2>/dev/null)
  [ $? -ne 124 ] || return 0
  printf '%s\n' "$times" | awk -v now="$2" -v ahead="$AHEAD" '
    $1 != "" { t = int($1) } t > now && t <= now + ahead && t > best { best = t }
    END { if (best) print best + 2 }'
}

# The kernel's time zone (#9): FAT keeps local times, and the kernel converts file times with its own
# offset, which systemd leaves at 0 (UTC), so recordings showed 1-2 h early on a computer in the
# Netherlands. hwclock --systz --utc sets that offset from /etc/localtime (the server mod's time
# zone setting) and nothing else: it neither sets the clock nor reads or writes the RTC. A fixed
# offset: the run loop gives it again when summer time starts or ends. Before the floor, which
# compares file times with the clock.
zone() {
  local z
  # (also when it fails: tried again at the next change, not every minute)
  z=$(date +%z) ZONE=$z
  hwclock --systz --utc 2> /dev/null || { log "cannot give the kernel the time zone"; return 1; }
  log "kernel time zone: $(date +%Z) (UTC$z)"
}

# milliseconds since power-on: the time the floor took, not counting the jump it makes
uptime_ms() { awk '{ printf "%d", $1 * 1000 }' /proc/uptime; }

# floor <dir>: DLZDATA, mounted by the caller
floor() {
  local t0 now to
  zone
  t0=$(uptime_ms)
  now=$(date +%s)
  to=$(newest "$1" "$now")
  if [ -n "$to" ]; then
    date -u -s "@$to" > /dev/null && log "clock moved forward $((to - now)) s, past the newest file on DLZDATA ($(( $(uptime_ms) - t0 )) ms)"
  else
    log "no newer file on DLZDATA, clock stays at $(date -u '+%F %T') ($(( $(uptime_ms) - t0 )) ms)"
  fi
}

run() {
  # (temp files of saves a power cut ended)
  rm -f "$FILE".dlzmod-new.*
  trap 'save; exit 0' TERM
  save
  # sleep in the background: the TERM is handled at once, not after the minute
  while :; do
    [ "$(date +%z)" = "$ZONE" ] || zone
    sleep "$INTERVAL" & wait $!; save
  done
}

case ${1:-} in
  floor) [ -n "${2:-}" ] || { echo "usage: dlzmod-clock floor <dir>" >&2; exit 2; }; floor "$2" ;;
  save) save ;;
  run) run ;;
  zone) zone ;;
  newest) newest "$2" "$3" ;;
  *) echo "usage: dlzmod-clock floor <dir>|save|run|zone|newest <dir> <now>" >&2; exit 2 ;;
esac
