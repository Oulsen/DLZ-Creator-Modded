[Unit]
Description=dlzmod: save the clock every minute (it goes on from there after a power-off)
After=local-fs.target fake-hwclock.service dlzmod-clock-floor.service

[Service]
Type=simple
ExecStart=/usr/local/sbin/dlzmod-clock run
ExecStop=/usr/local/sbin/dlzmod-clock save
Restart=on-failure
RestartSec=60

[Install]
WantedBy=multi-user.target
