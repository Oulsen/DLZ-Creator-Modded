[Unit]
Description=dlzmod: move the clock past DLZDATA's newest file (a power-off after the last save)
# after the update, which mounts DLZDATA itself: not before it, which would hold it (and Mackie's
# node processes after it) behind basic.target again (#141; this unit has the default dependencies,
# the updaters on the cards refuse a unit without them). What the update writes carries this start's
# clock, so it is not ahead of it.
After=local-fs.target fake-hwclock.service dlzmod-grow-data.service dlzmod-update.service
# before the mixer software writes to DLZDATA, and before the saver's first save
Before=dlzmod-clock.service evolve-node.service evolve-app.service dspserver.service

[Service]
# once per start (not again when the saver restarts); a failure leaves the clock as fake-hwclock
# loaded it
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=30
ExecStart=/usr/local/sbin/dlzmod-clock floor

[Install]
WantedBy=multi-user.target
