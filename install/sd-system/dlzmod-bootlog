#!/bin/sh
# The syslog of the last starts of the SD system, for DLZDATA/dlzmod-logs/ (read in any card reader,
# no SSH needed). Run by dlzmod-bootreport once its report of this start is in the log, so the copy
# holds that report too. Writes only to /run (RAM): server.js copies the file to the card
# (DLZMOD_bootlogCopy) through its queue of remounts, never a second mount of DLZDATA. #136: this
# script used to mount DLZDATA itself ~10 s into the start, where starts hang (#81), and a start that
# froze while it wrote left a broken FAT chain; now a start that hangs writes nothing to the card and
# is in the copy of the next start that finishes. Only boots of the SD system are copied (their
# sections contain the dlzmod-grow-data unit, which runs at every boot), not the device's own history
# from the dump. Not dlzmod-emmc-ro: it runs so early that its lines can land before the kernel's
# "Booting Linux" line, i.e. in the previous (stock) boot's section.
set -u

log() { echo "dlzmod-bootlog: $*"; }
# milliseconds since start, to see what a slow run spends here
ms() { echo $(( $(date +%s%3N) - t0 )); }
t0=$(date +%s%3N)
BOOTS=4   # this start, finished, and the 3 before it (starts that hung among them)
OUT=${DLZMOD_BOOTLOG_DIR:-/run/dlzmod-bootlog}
SYSLOG=${DLZMOD_BOOTLOG_SYSLOG:-/var/log/syslog}

mkdir -p "$OUT" || exit 1
tmp=$OUT/syslog-last-boots.txt.part
raw=$(mktemp)
# syslog is not rotated on this system (logrotate.timer is off); syslog.1 only if that changes.
# tail -c on a file seeks, so a large syslog costs nothing.
{
  [ -f "$SYSLOG.1" ] && tail -c 4000000 "$SYSLOG.1"
  tail -c 4000000 "$SYSLOG"
} > "$raw"
# One pass for the line ranges of the last SD boots, then sed copies them: linear. (Collecting the
# sections in awk strings was quadratic and took 7 s on the device.)
awk -v keep="$BOOTS" '
  /Booting Linux on physical CPU/ { n++; first[n] = NR }
  n && /dlzmod: grow DLZDATA|dlzmod-grow-data/ { sd[n] = 1 }
  END {
    first[n + 1] = NR + 1
    c = 0
    for (i = n; i >= 1 && c < keep; i--) if (sd[i]) pick[++c] = i
    for (j = c; j >= 1; j--) print first[pick[j]], first[pick[j] + 1] - 1
  }' "$raw" > "$raw.ranges"
total=$(wc -l < "$raw.ranges")
k=0
while read -r from to; do
  k=$((k + 1))
  echo "===== boot $k of $total (oldest first) ====="
  sed -n "${from},${to}p" "$raw"
done < "$raw.ranges" > "$tmp"
rm -f "$raw" "$raw.ranges"
# no SD start found (a syslog cut short): keep the last file, an empty one would push the good copy
# on DLZDATA out to .prev
if [ "$total" = 0 ]; then
  rm -f "$tmp"
  log "no start of the SD system in $SYSLOG, nothing new for DLZDATA/dlzmod-logs"
  exit 0
fi
# complete or not there: server.js copies whatever file it finds
if ! mv -f "$tmp" "$OUT/syslog-last-boots.txt"; then
  log "cannot write $OUT/syslog-last-boots.txt"
  rm -f "$tmp"
  exit 1
fi
log "$total boot(s), $(wc -c < "$OUT/syslog-last-boots.txt") bytes ready for DLZDATA/dlzmod-logs (ms: $(ms))"
