#!/bin/sh
# ExecStartPre of dspserver (SD system): wait for server.js, then for glesgui's graphics.
# - server.js (evolve-node) listening on port 80: dspserver connects to it once, right after its init
#   ("Waiting for graphics... Done."), and does not retry: when it is done first, it never gets its
#   state (no audio, mic dead, REC ignored) until a reboot. Normally the server wins by seconds;
#   anything that slows the boot (the first-boot grow) flips the order.
# - glesgui past its stops (#239): its graphics start runs `killall -STOP` on dspserver twice and
#   -CONT ~8 s later, on every start. With the start order of #141 that can land in the middle of
#   dspserver's chip init, and then the outputs can stay silent until another start. Started after
#   the second stop nothing is stopped. glesgui opens the GPU only after it (the window's context), so
#   its /dev/dri file is the sign.
# Gives up after 50 s in all and lets dspserver start anyway, as stock would (its unit allows 60 s).
# Timed on /proc/uptime, not by counting turns: on a busy start each turn costs more than its sleep,
# and running past the unit's limit would kill this script and fail the unit.
PROC=${DLZMOD_WAIT_PROC:-/proc}
LIMIT=5000   # hundredths of a second

now() {
  read -r up _ < "$PROC/uptime"
  echo "${up%.*}${up#*.}"
}

START=$(now)
elapsed() { echo $(($(now) - START)); }
late() { [ "$(elapsed)" -ge $LIMIT ]; }
took() { e=$(elapsed); echo "$((e / 100)).$((e % 100 / 10)) s"; }

graphics_up() {
  for p in $(pidof glesgui 2> /dev/null); do
    ls -l "$PROC/$p/fd" 2> /dev/null | grep -q /dev/dri/ && return 0
  done
  return 1
}

waited=0
until [ -n "$(ss -Hltn 'sport = :80' 2> /dev/null)" ]; do
  if late; then
    echo "dlzmod-wait-hub: nothing on port 80 after $(took), starting dspserver anyway" >&2
    exit 0
  fi
  sleep 0.2
  waited=1
done
[ $waited = 1 ] && echo "dlzmod-wait-hub: server.js listening after $(took)"

until graphics_up; do
  if late; then
    echo "dlzmod-wait-hub: no graphics after $(took), starting dspserver anyway" >&2
    exit 0
  fi
  sleep 0.2
done
echo "dlzmod-wait-hub: glesgui's graphics up after $(took)"
exit 0
