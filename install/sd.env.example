# Config for build-sd.sh: SDCONF=/root/dlz/sd.env bash build-sd.sh ...
# Copy to /root/dlz/sd.env inside WSL (outside this repo) and fill in. Never commit the real file.
# KEY=value, no spaces around '='; values are taken literally (one pair of quotes is stripped).
# Test cards only: the key is baked into the image, and SSH stays on, also after a restart.
# Wi-Fi is set on the mixer's screen (Mod page, Network); WIFI_* lines from an older file are ignored.

# Public key for root login, as seen from WSL. Leave empty to skip. The card allows 3 tries per
# connection: with several keys in an ssh-agent, log in with `ssh -o IdentitiesOnly=yes -i <key>`.
SSH_PUBKEY=/mnt/c/Users/<you>/.ssh/id_ed25519.pub
# the card never keeps Mackie's vendor keys anyway (apply-mod.sh, remove_factory_access); yes = empty
# root's authorized_keys first, so SSH_PUBKEY is the only key (needs SSH_PUBKEY); no = add it
SSH_DROP_VENDOR_KEYS=yes
# no = key-only login (the default with SSH_PUBKEY); yes = also root's password (the factory one)
SSH_PASSWORD_LOGIN=no
