# Settings for dev/push.sh: copy to dev/push.env (git-ignored) and fill in. Read by name, never
# sourced; no passwords here (SSH key login only).

# the dev card's address on the network (Settings, DLZ Creator Modded, Network, on the mixer's screen)
MIXER_HOST=192.168.1.50

# the private SSH key whose .pub is in the card's /root/.ssh/authorized_keys (Git Bash path, no
# quotes); empty: ssh's defaults. Best a key of its own without a passphrase, only for the dev card
# (docs/DEVELOPMENT.md, "Dev card"): push.sh and the mixer-ssh skill (dlz-ssh.sh key) then log in
# unattended. A key with a passphrase: load it into ssh-agent first (the script never asks)
SSH_KEY=~/.ssh/dlz-dev

# the folder with your dev.pem (mkkeys.sh), as a Windows or Git Bash path; empty: ~/.dlzmod-keys
KEYS_DIR=
